{
  "$description": "Neo-brutalist design tokens (source of truth: assets/src/brutal/brutal.css). Colors in hex, sizes in px/CSS units.",
  "color": {
    "palette": {
      "yellow": { "value": "#ffd600", "role": "brand, hero, active state, highlight marks, CTAs" },
      "pink":   { "value": "#ff6b9d", "role": "accent, hover, offset blocks, big-title text-shadow, primary buttons" },
      "blue":   { "value": "#5b8cff", "role": "work section, stat tile, focus ring" },
      "green":  { "value": "#3ddc84", "role": "status, success, stat tile, stack column 1" },
      "orange": { "value": "#ff8a3d", "role": "secondary highlight tile, stack column 3" },
      "lilac":  { "value": "#c3b1ff", "role": "experience section, stack column 2" },
      "black":  { "value": "#111111", "role": "borders on saturated fills, tags, footer, ticker" }
    },
    "neutral": {
      "light": { "paper": "#fffdf5", "paper2": "#f3eedd", "card": "#ffffff", "text": "#111111", "mute": "#4d4a42", "line": "#111111" },
      "dark":  { "paper": "#151515", "paper2": "#1e1e1e", "card": "#242424", "text": "#f5f1e6", "mute": "#b5b0a2", "line": "#f5f1e6" }
    },
    "feedback": { "error": "#d6002f", "errorTint": "#ffd9d9" },
    "rule": "Text on any saturated fill is #111 with #111 borders, in both themes."
  },
  "typography": {
    "family": {
      "display": "'Bricolage Grotesque', 'Space Grotesk', system-ui, sans-serif",
      "body": "'Space Grotesk', 'Inter', system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, monospace",
      "arabic": "'Cairo', system-ui, sans-serif"
    },
    "scale": {
      "heroName": "clamp(64px, 13.5vw, 210px)",
      "caseTitle": "clamp(44px, 9vw, 140px)",
      "contactTitle": "clamp(52px, 11.5vw, 180px)",
      "sectionTitle": "clamp(44px, 8.5vw, 124px)",
      "statement": "clamp(26px, 3.6vw, 52px)",
      "cardTitle": "clamp(26px, 2.6vw, 38px)",
      "lead": "clamp(20px, 2.1vw, 30px)",
      "body": "17px",
      "bodyMobile": "16px",
      "label": "13px"
    },
    "tracking": { "display": "-0.04em", "label": "0.04em", "arabic": "0" },
    "lineHeight": { "display": "0.86–1.05", "body": "1.5", "arabic": "1.15–1.7" }
  },
  "shape": {
    "radius": "0 (square); 50% only for dots and the sticker",
    "border": { "default": "3px", "small": "2px", "dashed": "3px" },
    "shadow": { "chip": "3px", "small": "4px", "control": "5px", "default": "6px", "note": "7px", "card": "8px", "form": "9px–10px", "hover": "+3px", "active": "0", "rule": "solid offset, no blur: x y 0 color" },
    "tilt": { "card": "±0.6°–0.8°", "panel": "±1°–1.6°", "tag": "±2°", "badge": "−4°…−6°" }
  },
  "layout": {
    "contentWidth": "1380px",
    "gutter": "clamp(18px, 4vw, 48px)",
    "sectionPadding": "clamp(64px, 9vw, 128px)",
    "navHeight": "76px",
    "breakpoints": { "tablet": "1000px", "mobile": "720px", "small": "560px" }
  },
  "motion": {
    "easing": { "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)", "slide": "cubic-bezier(0.7, 0, 0.2, 1)" },
    "duration": { "button": "0.18s", "card": "0.2–0.3s", "revealOpacity": "0.55s", "revealTransform": "0.7s", "slide": "0.5–0.7s", "accordion": "0.45s" },
    "loops": { "blink": "1.2s steps(2)", "spin": "14s linear", "ticker": "30s linear", "eq": "0.9s" },
    "rule": "Animate transform and opacity only. Respect prefers-reduced-motion."
  },
  "zIndex": { "ticker": 1, "sticker": 2, "overlayBar": 3, "sheet": 999, "nav": 1000, "progress": 1100, "chat": 1500, "caseOverlay": 2000, "skip": 3000, "loader": 4000 }
}
